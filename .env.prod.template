# 生产环境变量模板
# 复制此文件为 .env.prod 并填写实际值

# 数据库配置
DATABASE_URL=postgresql://smartfish:YOUR_PASSWORD@db:5432/smartfish
POSTGRES_DB=smartfish
POSTGRES_USER=smartfish
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# 应用配置
SECRET_KEY=YOUR_SECRET_KEY_HERE
FLASK_ENV=production

